---
/**
 * Exchange PKCE code for session and redirect to password reset form
 * This page handles the PKCE flow used by Supabase
 */
export const prerender = false;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weryfikacja - 10xCards</title>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
      }
      .loader {
        text-align: center;
      }
      .spinner {
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top: 3px solid white;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 0 auto 1rem;
      }
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      .error {
        color: #ff6b6b;
        margin-top: 1rem;
      }
    </style>
  </head>
  <body>
    <div class="loader">
      <div class="spinner"></div>
      <p id="status">Weryfikacja linku...</p>
      <p id="error" class="error" style="display: none;"></p>
    </div>

    <script>
      const statusEl = document.getElementById('status');
      const errorEl = document.getElementById('error');

      function showError(message) {
        statusEl.textContent = 'Błąd weryfikacji';
        errorEl.textContent = message;
        errorEl.style.display = 'block';
        console.error('Exchange error:', message);
        setTimeout(() => {
          window.location.href = '/auth/forgot-password?error=verification_failed';
        }, 3000);
      }

      async function exchangeCode() {
        try {
          // Get code from sessionStorage or URL
          const params = new URLSearchParams(window.location.search);
          const code = params.get('code') || sessionStorage.getItem('supabase_pkce_code');

          // If code is in URL but not in sessionStorage, redirect back to landing page
          if (params.get('code') && !sessionStorage.getItem('supabase_pkce_code')) {
            console.log('Code found in URL, redirecting to landing page first');
            window.location.href = `/auth/reset-password?code=${params.get('code')}`;
            return;
          }

          if (!code) {
            console.error('No PKCE code found');
            showError('Brak kodu weryfikacyjnego');
            return;
          }

          console.log('🔄 Exchanging PKCE code for session (server-side)...');
          statusEl.textContent = 'Wymiana kodu na sesję...';

          // Exchange code for session via server-side API
          console.log('📤 Sending request to /api/auth/exchange-code');
          
          let response;
          try {
            response = await fetch('/api/auth/exchange-code', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ code }),
              credentials: 'same-origin', // Important for cookies
            });
          } catch (fetchError) {
            console.error('❌ Network error while calling API:', fetchError);
            showError('Błąd sieci podczas wymiany kodu');
            return;
          }

          console.log('📥 Response status:', response.status, response.statusText);

          // Clear the stored code
          sessionStorage.removeItem('supabase_pkce_code');

          // Get response text first (can only read body once)
          const responseText = await response.text();
          console.log('📥 Response text length:', responseText.length);
          console.log('📥 Response preview (first 500 chars):', responseText.substring(0, 500));

          let data;
          try {
            data = JSON.parse(responseText);
            console.log('📥 Response data:', data);
          } catch (jsonError) {
            console.error('❌ Failed to parse response JSON:', jsonError);
            console.error('   Response is HTML, not JSON');
            console.error('   First 1000 chars:', responseText.substring(0, 1000));
            
            // Check if it's an HTML error page
            if (responseText.includes('<html') || responseText.includes('<!DOCTYPE')) {
              showError('Serwer zwrócił stronę HTML zamiast danych (prawdopodobnie błąd 500)');
            } else {
              showError('Nieprawidłowa odpowiedź serwera');
            }
            return;
          }

          if (!response.ok) {
            console.error('❌ Server returned error:', data);
            console.error('   Status:', response.status);
            console.error('   Error:', data.error);
            console.error('   Details:', data.details);
            showError(data.error || 'Nie udało się wymienić kodu');
            return;
          }

          console.log('✅ Session created successfully');
          console.log('User:', data.user?.email);

          // Success! User now has an active session
          // Redirect to password reset form (without token - will use active session)
          statusEl.textContent = 'Weryfikacja udana! Przekierowywanie...';
          
          // Wait a moment and redirect
          setTimeout(() => {
            window.location.href = '/auth/reset-password/with-session';
          }, 1000);

        } catch (error) {
          console.error('Unexpected error:', error);
          showError('Wystąpił nieoczekiwany błąd');
        }
      }

      // Start the exchange process
      exchangeCode();
    </script>
  </body>
</html>

