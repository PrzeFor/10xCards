---
/**
 * Landing page for password reset redirect from Supabase
 * Extracts token from URL and redirects to the reset password form
 */
export const prerender = false;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Przekierowanie - 10xCards</title>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
      }
      .loader {
        text-align: center;
      }
      .spinner {
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top: 3px solid white;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 0 auto 1rem;
      }
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
    </style>
  </head>
  <body>
    <div class="loader">
      <div class="spinner"></div>
      <p>Przekierowywanie...</p>
    </div>

    <script>
      console.log('🔍 Password Reset Landing Page');
      console.log('Full URL:', window.location.href);
      console.log('Hash:', window.location.hash);
      console.log('Search:', window.location.search);

      // Wait a moment for any hash fragments to be set (some browsers delay this)
      setTimeout(() => {
        // Extract token from URL hash or query parameters
        const hash = window.location.hash.substring(1);
        const hashParams = new URLSearchParams(hash);
        const searchParams = new URLSearchParams(window.location.search);

        // Debug: Log all parameters
        console.log('\n📝 Hash parameters:');
        if (hash) {
          for (const [key, value] of hashParams.entries()) {
            console.log(`  ${key}:`, key.includes('token') || key.includes('access') ? '[HIDDEN]' : value);
          }
        } else {
          console.log('  (none)');
        }

        console.log('\n📝 Query parameters:');
        if (window.location.search) {
          for (const [key, value] of searchParams.entries()) {
            console.log(`  ${key}:`, key.includes('token') || key.includes('access') ? '[HIDDEN]' : value);
          }
        } else {
          console.log('  (none)');
        }

        // Try to extract token or code
        let token = hashParams.get('token_hash') || hashParams.get('access_token');
        const code = hashParams.get('code') || searchParams.get('code');
        const type = hashParams.get('type');
        const error = hashParams.get('error') || searchParams.get('error');
        const errorDescription = hashParams.get('error_description') || searchParams.get('error_description');

        console.log('\n🔍 Extracted values:');
        console.log('  Token:', token ? 'FOUND' : 'NOT FOUND');
        console.log('  Code (PKCE):', code ? 'FOUND' : 'NOT FOUND');
        console.log('  Type:', type || 'not specified');
        console.log('  Error:', error || 'none');
        if (errorDescription) {
          console.log('  Error description:', errorDescription);
        }

        // If not in hash, try query parameters
        if (!token) {
          token = searchParams.get('token_hash') || searchParams.get('access_token') || searchParams.get('token');
          if (token) {
            console.log('  Token found in query params instead of hash');
          }
        }

        // Check for errors
        if (error) {
          console.error('❌ Error from Supabase:', error, errorDescription);
          const errorCode = hashParams.get('error_code') || searchParams.get('error_code');
          
          let errorMessage = 'Błąd: ' + (errorDescription || error);
          if (errorCode === 'otp_expired') {
            errorMessage = 'Link resetowania wygasł';
          }
          
          document.querySelector('.loader p').textContent = errorMessage;
          
          // Build error URL with all params
          const errorUrl = new URL('/auth/forgot-password', window.location.origin);
          errorUrl.searchParams.set('error', error);
          if (errorCode) {
            errorUrl.searchParams.set('error_code', errorCode);
          }
          
          setTimeout(() => {
            window.location.href = errorUrl.toString();
          }, 3000);
          return;
        }

        // If we found a PKCE code, handle it differently
        if (code) {
          console.log('✅ PKCE code found - exchanging for session');
          // Store code in sessionStorage and redirect to exchange page
          sessionStorage.setItem('supabase_pkce_code', code);
          window.location.href = '/auth/reset-password/exchange';
          return;
        }

        // If we found a token, redirect to reset form
        if (token) {
          console.log('✅ Token found - redirecting to reset password form');
          window.location.href = `/auth/reset-password/${token}`;
          return;
        }

        // No token or code found
        console.error('❌ No reset token or PKCE code found in URL');
        console.log('\n💡 This usually means:');
        console.log('  1. The redirect URL is not configured in Supabase Dashboard');
        console.log('  2. The token has expired');
        console.log('  3. The link was already used');
        console.log('\nℹ️  Please check Supabase Dashboard → Authentication → URL Configuration');
        console.log('   and ensure this URL is in Redirect URLs:');
        console.log('   https://10xcards-53m.pages.dev/auth/reset-password');

        document.querySelector('.loader p').textContent = 'Nie znaleziono tokena resetowania...';
        
        setTimeout(() => {
          window.location.href = '/auth/forgot-password?error=no_token';
        }, 3000);
      }, 500); // Wait 500ms for hash to be set
    </script>
  </body>
</html>
