---
import Welcome from '../components/Welcome.astro';
import Layout from '../components/layouts/Layout.astro';
import { FlashcardService } from '../lib/services/flashcard.service';

// Check if user is logged in
const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

// Fetch user statistics if logged in
let userStats = null;

if (user && supabase) {
  try {
    const flashcardService = new FlashcardService(supabase);
    
    // Get flashcard counts
    const { data: flashcardsData } = await supabase
      .from('flashcards')
      .select('id, srs_state', { count: 'exact' })
      .eq('user_id', user.id);
    
    const totalFlashcards = flashcardsData?.length || 0;
    
    // Count by SRS state
    const newCards = flashcardsData?.filter(f => f.srs_state === 'new').length || 0;
    const learningCards = flashcardsData?.filter(f => f.srs_state === 'learning').length || 0;
    const reviewCards = flashcardsData?.filter(f => f.srs_state === 'review').length || 0;
    
    // Get due cards count
    const dueCount = await flashcardService.getFlashcardsDueCount(user.id);
    
    // Get completed sessions count
    const { count: completedSessions } = await supabase
      .from('sessions')
      .select('*', { count: 'exact', head: true })
      .eq('user_id', user.id)
      .eq('status', 'completed');
    
    userStats = {
      totalFlashcards,
      newCards,
      learningCards,
      reviewCards,
      dueCount,
      completedSessions: completedSessions || 0,
    };
  } catch (error) {
    console.error('Error fetching user stats:', error);
  }
}
---

<Layout>
  <Welcome userStats={userStats} />
</Layout>
