---
interface Props {
  userStats?: {
    totalFlashcards: number;
    newCards: number;
    learningCards: number;
    reviewCards: number;
    dueCount: number;
    completedSessions: number;
  } | null;
}

const { userStats } = Astro.props;
---

<div class="relative w-full mx-auto min-h-screen bg-background p-fluent-l">
  <div
    class="relative max-w-4xl mx-auto elevation-16 bg-card rounded-fluent-xl p-fluent-xxl text-foreground border border-border"
  >
    <div class="space-y-12">
      <div class="text-center space-y-4">
        <h1 class="text-display text-brand">Witaj w 10xCards!</h1>
        <p class="text-subtitle text-muted-foreground">
          Inteligentny system nauki z wykorzystaniem sztucznej inteligencji
        </p>
      </div>

      {userStats && (
        <div class="space-y-6 sm:space-y-8">
          <div class="border-t border-border pt-6 sm:pt-8">
            <h2 class="text-xl sm:text-2xl font-bold text-center text-brand mb-4 sm:mb-6">Twoje statystyki</h2>
            
            <!-- Główne statystyki - duże, widoczne -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-6 max-w-4xl mx-auto mb-4 sm:mb-6">
              <!-- Total Flashcards -->
              <div class="bg-gradient-to-br from-card to-card/80 rounded-lg sm:rounded-xl p-4 sm:p-6 border border-border text-center hover:border-brand/50 hover:shadow-lg transition-all duration-200">
                <div class="text-3xl sm:text-5xl font-bold text-brand mb-1 sm:mb-3">{userStats.totalFlashcards}</div>
                <div class="text-xs sm:text-sm font-medium text-muted-foreground">Wszystkich fiszek</div>
              </div>
              
              <!-- Due for Review -->
              <div class="bg-gradient-to-br from-card to-card/80 rounded-lg sm:rounded-xl p-4 sm:p-6 border border-border text-center hover:border-warning/50 hover:shadow-lg transition-all duration-200">
                <div class="text-3xl sm:text-5xl font-bold text-warning mb-1 sm:mb-3">{userStats.dueCount}</div>
                <div class="text-xs sm:text-sm font-medium text-muted-foreground">Do powtórki dziś</div>
                <a href="/flashcards?message=start_session" class="inline-block mt-2 sm:mt-3 text-xs sm:text-sm text-brand hover:underline font-semibold">
                  Rozpocznij →
                </a>
              </div>
              
              <!-- Completed Sessions -->
              <div class="bg-gradient-to-br from-card to-card/80 rounded-lg sm:rounded-xl p-4 sm:p-6 border border-border text-center hover:border-success/50 hover:shadow-lg transition-all duration-200 col-span-2 sm:col-span-1">
                <div class="text-3xl sm:text-5xl font-bold text-success mb-1 sm:mb-3">{userStats.completedSessions}</div>
                <div class="text-xs sm:text-sm font-medium text-muted-foreground">Ukończonych sesji</div>
              </div>
            </div>
            
            <!-- Szczegółowe statystyki - kompaktowe -->
            <div class="border-t border-border/50 pt-4 sm:pt-6">
              <p class="text-xs sm:text-sm font-semibold text-muted-foreground text-center mb-3 sm:mb-4">Podział fiszek</p>
              <div class="grid grid-cols-3 gap-3 sm:gap-4 max-w-2xl mx-auto">
                <!-- New Cards -->
                <div class="bg-card/50 rounded-lg p-3 sm:p-4 border border-border/50 text-center">
                  <div class="text-2xl sm:text-3xl font-bold text-info mb-1">{userStats.newCards}</div>
                  <div class="text-xs text-muted-foreground">Nowe</div>
                </div>
                
                <!-- Learning Cards -->
                <div class="bg-card/50 rounded-lg p-3 sm:p-4 border border-border/50 text-center">
                  <div class="text-2xl sm:text-3xl font-bold text-warning mb-1">{userStats.learningCards}</div>
                  <div class="text-xs text-muted-foreground">W nauce</div>
                </div>
                
                <!-- Review Cards -->
                <div class="bg-card/50 rounded-lg p-3 sm:p-4 border border-border/50 text-center">
                  <div class="text-2xl sm:text-3xl font-bold text-success mb-1">{userStats.reviewCards}</div>
                  <div class="text-xs text-muted-foreground">Powtarzane</div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Quick Actions -->
          <div class="border-t border-border pt-6 sm:pt-8">
            <h3 class="text-base sm:text-lg font-semibold text-center text-foreground mb-4 sm:mb-6">Szybkie akcje</h3>
            <div class="flex flex-col sm:flex-row sm:flex-wrap justify-center gap-3 sm:gap-4">
              <a
                href="/generations"
                class="inline-flex items-center justify-center text-sm sm:text-base font-semibold text-white bg-brand hover:bg-brand/90 hover:scale-105 transition-all duration-200 px-6 sm:px-8 py-3 sm:py-3.5 rounded-lg sm:rounded-xl shadow-md hover:shadow-xl gap-2 w-full sm:w-auto sm:min-w-[200px] cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                Generuj fiszki
              </a>
              <a
                href="/flashcards"
                class="inline-flex items-center justify-center text-sm sm:text-base font-semibold text-foreground bg-subtle hover:bg-subtle/80 hover:scale-105 transition-all duration-200 px-6 sm:px-8 py-3 sm:py-3.5 rounded-lg sm:rounded-xl shadow-md hover:shadow-xl gap-2 border-2 border-border hover:border-brand/30 w-full sm:w-auto sm:min-w-[200px] cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                Przeglądaj fiszki
              </a>
              <a
                href="/flashcards?message=start_session"
                class="inline-flex items-center justify-center text-sm sm:text-base font-semibold text-white bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 hover:scale-105 transition-all duration-200 px-6 sm:px-8 py-3 sm:py-3.5 rounded-lg sm:rounded-xl shadow-md hover:shadow-xl gap-2 w-full sm:w-auto sm:min-w-[200px] cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
                Rozpocznij powtórki
              </a>
            </div>
          </div>
        </div>
      )}

      {!userStats && (
        <div class="border-t border-border pt-12 space-y-8">
          <p class="text-lg text-center text-muted-foreground leading-relaxed max-w-2xl mx-auto">
            Ucz się efektywniej z systemem inteligentnych powtórek (SRS). <br class="hidden sm:block" />
            Generuj fiszki z AI i śledź swój postęp!
          </p>

          <div class="text-center space-y-4">
            <a
              href="/auth/register"
              class="inline-flex items-center justify-center text-lg font-semibold text-white bg-brand hover:bg-brand/90 hover:scale-105 transition-all duration-200 px-10 py-4 rounded-xl shadow-lg hover:shadow-xl gap-3 cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Zacznij korzystać
            </a>
            <p class="text-base text-muted-foreground">
              Masz już konto? <a href="/auth/login" class="text-brand hover:underline font-semibold transition-colors">Zaloguj się</a>
            </p>
          </div>
        </div>
      )}
    </div>
  </div>
</div>
